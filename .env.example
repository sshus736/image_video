# 端口配置
PORT=3001

# ─── 主文本生成 API（ChatGPT 5.5 / OpenAI 兼容） ───
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
# 可选：覆盖模型名称（默认 gpt-5.5）
# TEXT_MODEL=gpt-5.5

# ─── 图像生成 API（gpt-image-2 反代） ───
IMAGE_API_BASE=https://wzjself.org/v1
IMAGE_API_KEY=your_image_api_key_here

# ─── 备用文本 API（可选，主 API 失败时自动降级） ───
# TEXT_API_BASE_FALLBACK=https://api.deepseek.com/v1
# TEXT_API_KEY_FALLBACK=your_deepseek_api_key_here
# TEXT_MODEL_FALLBACK=deepseek-v4-flash
